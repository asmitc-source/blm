# Copy to .env.local / Vercel project env. Never commit real secrets.

# --- Core ---
# DATABASE_URL=postgresql://...
# BETTER_AUTH_URL=https://businesslistingmanagement.com
# BETTER_AUTH_SECRET=
# SITE_URL=https://businesslistingmanagement.com
# VITE_AUTH_ENABLED=true

# --- Google social login (Better Auth) ---
# Create OAuth client in Google Cloud Console → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URIs (add ALL that you use):
#   https://businesslistingmanagement.com/api/auth/callback/google
#   https://www.businesslistingmanagement.com/api/auth/callback/google
#   https://businesslistingmanagement.co/api/auth/callback/google
#   https://www.businesslistingmanagement.co/api/auth/callback/google
#   http://localhost:8080/api/auth/callback/google
# Authorized JavaScript origins should include the same hosts (without the path).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_OAUTH_ENABLED=true

# --- Resend (newsletter / transactional email) ---
# Create an API key at https://resend.com — set only in Vercel / local env, never commit.
RESEND_API_KEY=
RESEND_FROM=BLM <hello@businesslistingmanagement.com>

# --- Legacy SMTP (optional; unused when Resend is configured) ---
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
