# Copy to .env.local / Vercel project env. Never commit real secrets.

# --- Core ---
# DATABASE_URL=postgresql://...
# BETTER_AUTH_URL=https://businesslistingmanagement.co
# BETTER_AUTH_SECRET=
# SITE_URL=https://businesslistingmanagement.co
# VITE_AUTH_ENABLED=true

# --- Google social login (Better Auth) ---
# Create OAuth client in Google Cloud Console → Credentials → OAuth 2.0 Client IDs
# Authorized redirect URI: https://<your-domain>/api/auth/callback/google
# (local: http://localhost:8080/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_OAUTH_ENABLED=true

# --- SMTP (GoDaddy Google Workspace / Microsoft 365 / secureserver) ---
# Prefer hello@nakama.in (or a BLM mailbox). Set SMTP_PASS only in Vercel / local env.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=hello@nakama.in
SMTP_PASS=
SMTP_FROM="BLM <hello@nakama.in>"
# Alternate GoDaddy classic: SMTP_HOST=smtpout.secureserver.net SMTP_PORT=465
